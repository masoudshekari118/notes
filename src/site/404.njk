<link href="/styles/custom-style.css" rel="stylesheet">

<style>
    .error-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.5rem;
        direction: rtl;
    }

    .error-box {
        width: min(680px, 100%);
        text-align: center;
        padding: 3.5rem 2.5rem;
        background: var(--surface, #ffffff);
        border: 1px solid var(--background-modifier-border, #dce6df);
        border-radius: 24px;
        box-shadow: var(--shadow-soft, 0 8px 30px rgba(38, 51, 44, .06));
    }

    .error-icon {
        width: 86px;
        height: 86px;
        margin: 0 auto 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--accent-soft, #e3f0e8);
        color: var(--accent-color, #26734d);
        font-size: 2.6rem;
    }

    .error-code {
        margin: 0;
        color: var(--accent-color, #26734d);
        font-size: 2.5rem;
        line-height: 1;
        font-weight: 800;
        letter-spacing: -.05em;
    }

    .error-title {
        margin: 1.2rem 0 .8rem;
        color: var(--text-normal, #26352d);
        font-size: 1.7rem;
        font-weight: 700;
    }

    .error-text {
        max-width: 500px;
        margin: 0 auto 1.8rem;
        color: var(--text-muted, #68776f);
        font-size: 1rem;
        line-height: 2;
    }

    .home-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        padding: .7rem 1.4rem;
        border-radius: 10px;
        background: var(--accent-color, #26734d);
        color: #fff !important;
        text-decoration: none !important;
        border: none !important;
        font-weight: 600;
        transition: all .2s ease;
    }

    .home-button:hover {
        background: var(--interactive-accent-hover, #1d5d3e);
        color: #fff !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(38, 115, 77, .18);
    }

    .error-note {
        margin-top: 1.8rem;
        color: var(--text-faint, #929e97);
        font-size: .8rem;
    }
</style>

</head>

<body class="theme-{{meta.baseTheme}} markdown-preview-view">

    <main class="error-page">

        <div class="error-box">

            <div class="error-icon">
                🌿
            </div>

            <p class="error-code">این ره که تو می‌روی به ترکستان است</p>

            <h1 class="error-title">
                این صفحه را پیدا نکردیم
            </h1>

            <p class="error-text">
                به نظر می‌رسد این صفحه هنوز منتشر نشده،
                جابه‌جا شده یا مسیرش تغییر کرده است.
                شاید بهتر باشد از صفحه اصلی دوباره شروع کنیم.
            </p>

            <a class="home-button" href="/">
                ← بازگشت به صفحه اصلی
            </a>

            <p class="error-note">
                هر سخن جایی و هر نکته مکانی دارد.
            </p>

        </div>

    </main>

</body>

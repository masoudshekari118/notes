---
permalink: "notes/{{ page.fileSlug | slugify }}/"
---

<!DOCTYPE html>
<html lang="{{ meta.mainLanguage }}" dir="rtl">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    {% if title %}
      {{ title }}
    {% else %}
      {{ page.fileSlug }}
    {% endif %}
    | مسعود شکری
  </title>

  {% include "components/pageheader.njk" %}

  {% for imp in dynamics.common.head %}
    {% include imp %}
  {% endfor %}

  {% for imp in dynamics.notes.head %}
    {% include imp %}
  {% endfor %}

</head>


<body
  class="theme-{{ meta.baseTheme }} {{ meta.bodyClasses }}"
>


  <!-- =========================
       NAVBAR
       ========================= -->

  {% include "components/navbar.njk" %}


  <!-- =========================
       NOTE PAGE
       ========================= -->

  <div class="note-container">


    <!-- =========================
         ARTICLE HEADER
         ========================= -->

    <header class="note-header">

      {% if settings.dgShowInlineTitle === true %}

        <h1 class="note-title">

          {% if title %}
            {{ title }}
          {% else %}
            {{ page.fileSlug }}
          {% endif %}

        </h1>

      {% endif %}


      <!-- TAGS -->

      {% if settings.dgShowTags === true and tags %}

        <div class="note-tags">

          {% for tag in tags %}

            {% if tag != 'gardenEntry' and tag != 'note' %}

              <a
                class="tag"
                onclick="toggleTagSearch(this)"
              >
                #{{ tag }}
              </a>

            {% endif %}

          {% endfor %}

        </div>

      {% endif %}


      <!-- DATES -->

      {% if meta.timestampSettings.showCreated or meta.timestampSettings.showUpdated %}

        <div class="note-meta">

          {% if meta.timestampSettings.showCreated and created %}

            <span class="note-date">

              <i data-lucide="calendar-plus"></i>

              <span
                class="human-date"
                data-date="{{ created }}"
              ></span>

            </span>

          {% endif %}


          {% if meta.timestampSettings.showUpdated and updated %}

            <span class="note-date">

              <i data-lucide="calendar-clock"></i>

              <span
                class="human-date"
                data-date="{{ updated }}"
              ></span>

            </span>

          {% endif %}

        </div>

      {% endif %}


      {% for imp in dynamics.common.header %}
        {% include imp %}
      {% endfor %}

      {% for imp in dynamics.notes.header %}
        {% include imp %}
      {% endfor %}

    </header>



    <!-- =========================
         CONTENT
         ========================= -->

    <main class="note-content">

      {% for imp in dynamics.common.beforeContent %}
        {% include imp %}
      {% endfor %}

      {% for imp in dynamics.notes.beforeContent %}
        {% include imp %}
      {% endfor %}


      {{ content | hideDataview | taggify | link | safe }}


      {% for imp in dynamics.common.afterContent %}
        {% include imp %}
      {% endfor %}

      {% for imp in dynamics.notes.afterContent %}
        {% include imp %}
      {% endfor %}

    </main>



    <!-- =========================
         NOTE FOOTER
         ========================= -->

    <div class="note-footer">

      {% if settings.dgShowBacklinks === true
         or settings.dgShowLocalGraph === true
         or settings.dgShowToc === true
         or dynamics.sidebar.top.length > 0
         or dynamics.sidebar.bottom.length > 0 %}

        {% include "components/sidebar.njk" %}

      {% endif %}

    </div>


  </div>



  <!-- =========================
       FOOTER
       ========================= -->

  {% include "components/footer.njk" %}


  {% if settings.dgLinkPreview === true %}
    {% include "components/linkPreview.njk" %}
  {% endif %}

  {% include "components/references.njk" %}

  {% include "components/timestamps.njk" %}


  {% for imp in dynamics.common.footer %}
    {% include imp %}
  {% endfor %}

  {% for imp in dynamics.notes.footer %}
    {% include imp %}
  {% endfor %}


  {% include "components/lucideIcons.njk" %}


  {% if contentClasses and "canvas-page" in contentClasses %}

    {% include "components/canvasScript.njk" %}

  {% endif %}


  {% include "components/basesScript.njk" %}


</body>

</html>

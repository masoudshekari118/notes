{% if settings.dgHomeLink === true %}

<nav class="navbar">

  <div class="navbar-inner">

    <a class="navbar-brand" href="{{ "/" | url }}">
      {{ meta.siteName }}
    </a>

    <div class="navbar-links">

      <a href="{{ "/" | url }}">
        خانه
      </a>

      <a href="{{ "/notes" | url }}">
        یادداشت‌ها
      </a>

      <a href="{{ "/about" | url }}">
        درباره من
      </a>

      <a href="{{ "/resume" | url }}">
        رزومه
      </a>

    </div>

    <div class="navbar-actions">

      {% if settings.dgEnableSearch === true %}
        {% include "components/searchButton.njk" %}
      {% endif %}

      <button
        class="navbar-theme-toggle"
        type="button"
        aria-label="تغییر حالت روشن و تاریک"
        onclick="document.documentElement.classList.toggle('dark')"
      >
        ☼
      </button>

    </div>

  </div>

</nav>

{% else %}

<nav class="navbar">

  <div class="navbar-inner">

    <a class="navbar-brand" href="{{ "/" | url }}">
      {{ meta.siteName }}
    </a>

    <div class="navbar-links">

      <a href="{{ "/" | url }}">
        خانه
      </a>

      <a href="{{ "/notes" | url }}">
        یادداشت‌ها
      </a>

      <a href="{{ "/about" | url }}">
        درباره من
      </a>

      <a href="{{ "/resume" | url }}">
        رزومه
      </a>

    </div>

    <div class="navbar-actions">

      {% if settings.dgEnableSearch === true %}
        {% include "components/searchButton.njk" %}
      {% endif %}

      <button
        class="navbar-theme-toggle"
        type="button"
        aria-label="تغییر حالت روشن و تاریک"
        onclick="document.documentElement.classList.toggle('dark')"
      >
        ☼
      </button>

    </div>

  </div>

</nav>

{% endif %}

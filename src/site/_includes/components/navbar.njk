{%if settings.dgHomeLink === true%}
    <nav class="navbar glass-navbar">
        <div class="navbar-inner">
            <a href="/" class="brand-link">
                {% if meta.siteLogoPath %}
                    <img class="site-logo" src="{{meta.siteLogoPath}}" alt="{{meta.siteName}}">
                {% else %}
                    <h1 class="brand-title">{{meta.siteName}}</h1>
                {% endif %}
            </a>
        </div>

        <!-- لینک‌های سفارشی نوار ناوبری -->
        <div class="nav-links">
            <a href="/about" class="nav-item">درباره من</a>
            <a href="/contact" class="nav-item">تماس</a>
        </div>

        <div class="navbar-actions">
            {% set slotName = "navbar.actions" %}{% include "components/pluginSlot.njk" %}
            {% include "components/pagePanelButton.njk" %}
        </div>
    </nav>
{%else%}
    <div class="empty-navbar glass-navbar">
        {% set slotName = "navbar.actions" %}{% include "components/pluginSlot.njk" %}
    </div>
{%endif%}

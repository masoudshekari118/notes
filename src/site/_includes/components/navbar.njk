import { useState, useEffect } from 'react'
import Link from 'next/link'

export default function Header() {
  const [dark, setDark] = useState(false)

  useEffect(() => {
    if (localStorage.getItem('theme') === 'dark') {
      document.documentElement.classList.add('dark')
      setDark(true)
    }
  }, [])

  const toggleTheme = () => {
    if (dark) {
      document.documentElement.classList.remove('dark')
      localStorage.setItem('theme', 'light')
    } else {
      document.documentElement.classList.add('dark')
      localStorage.setItem('theme', 'dark')
    }
    setDark(!dark)
  }

  return (
    <header className="site-header">
      <div className="header-inner">
        <Link href="/" className="site-logo">🌱 مسعود شکری</Link>
        <div className="header-search">
          {/* اگر کامپوننت جستجو داری، اینجا بگذار.
              می‌تونی از یک input ساده استفاده کنی که بعداً با کتابخانه جستجو ادغام بشه */}
          <input type="text" placeholder="جستجو..." className="search-input" />
        </div>
        <nav className="header-nav">
          <Link href="/about">درباره من</Link>
          <Link href="/resume">رزومه</Link>
          <button onClick={toggleTheme} className="theme-toggle" aria-label="تغییر تم">
            {dark ? '☀️' : '🌙'}
          </button>
        </nav>
      </div>
    </header>
  )
}

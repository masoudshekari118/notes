<aside class="site-sidebar">

  <div class="sidebar-container">


    {% if dynamics.sidebar.top.length > 0 %}

      <section class="sidebar-section">

        <div class="sidebar-section-header">

          <span class="sidebar-section-icon">
            <i data-lucide="layers-3"></i>
          </span>

          <span class="sidebar-section-title">
            بخش‌های مرتبط
          </span>

        </div>

        <div class="sidebar-section-content">

          {% for imp in dynamics.sidebar.top %}

            {% include imp %}

          {% endfor %}

        </div>

      </section>

    {% endif %}


    {% if settings.dgShowLocalGraph === true %}

      <section class="sidebar-section">

        <div class="sidebar-section-header">

          <span class="sidebar-section-icon">
            <i data-lucide="network"></i>
          </span>

          <span class="sidebar-section-title">
            ارتباطات یادداشت
          </span>

        </div>

        <div class="sidebar-section-content sidebar-graph">

          {% include "components/graphScript.njk" %}

        </div>

      </section>

    {% endif %}


    {% if settings.dgShowBacklinks === true %}

      <section class="sidebar-section">

        <div class="sidebar-section-header">

          <span class="sidebar-section-icon">
            <i data-lucide="link-2"></i>
          </span>

          <span class="sidebar-section-title">
            یادداشت‌های مرتبط
          </span>

        </div>

        <div class="sidebar-section-content">

          <div class="sidebar-backlink-list">

            {% set currentNode = graph.nodes[page.url] or graph.nodes[graph.homeAlias] %}

            {% if currentNode %}

              {% if currentNode.backLinks.length === 0 %}

                <div class="sidebar-empty">
                  هنوز یادداشت مرتبطی وجود ندارد.
                </div>

              {% endif %}


              {% for backlink in currentNode.backLinks %}

                {% if graph.nodes[backlink].url != page.url and not graph.nodes[backlink].private %}

                  <div class="sidebar-backlink-card">

                    <a
                      href="{{ graph.nodes[backlink].url }}"
                      class="sidebar-backlink">

                      {{ graph.nodes[backlink].title }}

                    </a>

                  </div>

                {% endif %}

              {% endfor %}

            {% endif %}

          </div>

        </div>

      </section>

    {% endif %}


    {% if settings.dgShowToc === true %}

      {% set tocHtml = (content and (content | hideDataview | link | toc)) %}

      {% if tocHtml %}

        <section class="sidebar-section sidebar-left-toc">

          <div class="sidebar-section-header">

            <span class="sidebar-section-icon">
              <i data-lucide="list-tree"></i>
            </span>

            <span class="sidebar-section-title">
              فهرست این یادداشت
            </span>

          </div>

          <div class="sidebar-section-content">

            <div class="sidebar-toc">

              {{ tocHtml | safe }}

            </div>

          </div>

        </section>

      {% endif %}

    {% endif %}


    {% for imp in dynamics.sidebar.bottom %}

      <section class="sidebar-section">

        <div class="sidebar-section-content">

          {% include imp %}

        </div>

      </section>

    {% endfor %}


  </div>

</aside>
